# The Witt design `S(4,5,11)` and its automorphism group (research track A)

`w11` is the design of the perfect ternary Golay code: 11 points, 66 blocks of size 5
(`WittData`, generated by `experiments/witt_m11.py`). It is the second self-transversal
Steiner system after the Fano plane.

| Lean | Statement |
| --- | --- |
| `w11_steiner` | **Observation A1.** 66 blocks of size 5; every 4-set lies in exactly one block |
| `w11_self_tr` | **Observation A1.** `Tr(w11) = w11` |
| `w11_meet` | **Observation A1.** two distinct blocks meet in 1, 2 or 3 points (495, 660, 990 pairs) |
| `eq_one_of_fixes_base` | an automorphism fixing `0, 1, 2, 3` is the identity |
| `card_aut_w11` | **Theorem A2.** `|Aut(w11)| = 7920` |
| `w11_four_transitive`, `w11_four_free` | **Theorem A2.** `Aut(w11)` is sharply 4-transitive |
| `w11_preprimitive` | `Aut(w11)` is primitive |

The finite checks use `native_decide` and so trust the Lean compiler (`Lean.ofReduceBool`).
The group order is not found by enumerating `11!` permutations: the 5040 permutations fixing
`0..3` are checked once, which makes `σ ↦ (σ 0, σ 1, σ 2, σ 3)` injective on `Aut(w11)`;
an explicit automorphism for each of the `11·10·9·8 = 7920` ordered 4-tuples makes it
surjective. By Jordan's theorem a sharply 4-transitive group of degree 11 is the Mathieu
group `M₁₁`; that identification is cited, not proved here.
-/
import HypergraphDualization.WittData
import HypergraphDualization.Symmetry
import Mathlib.GroupTheory.GroupAction.MultipleTransitivity
import Mathlib.Data.Fintype.CardEmbedding

namespace HD.Witt

open HD Finset

/-- Membership in `aut` checked edge by edge, the form the finite checks use. -/
theorem mem_aut_iff_forall {α : Type*} [DecidableEq α] {H : Finset (Finset α)}
    {σ : Equiv.Perm α} : σ ∈ aut H ↔ ∀ e ∈ H, pmap σ e ∈ H := by
  constructor
  · intro h e he
    rw [← mem_aut.1 h]
    exact mem_image_of_mem _ he
  · intro h
    exact mem_aut_of_subset (image_subset_iff.2 h)

/-! ### Observation A1 -/

/-- **Observation A1 (Steiner).** `w11` has 66 blocks, each of size 5, and every 4-set of
points lies in exactly one block: `w11` is a Steiner system `S(4,5,11)`. -/
theorem w11_steiner :
    w11.card = 66 ∧ (∀ e ∈ w11, e.card = 5) ∧
    ∀ s : Finset (Fin 11), s.card = 4 → (w11.filter (s ⊆ ·)).card = 1 := by
  native_decide

/-- **Observation A1 (self-transversal).** `Tr(w11) = w11`. -/
theorem w11_self_tr : tr univ w11 = w11 := by native_decide

/-- **Observation A1 (intersections).** Two distinct blocks meet in 1, 2 or 3 points; over
ordered pairs the three sizes occur 990, 1320 and 1980 times (495, 660, 990 unordered). -/
theorem w11_meet :
    (∀ e ∈ w11, ∀ f ∈ w11, e ≠ f → (e ∩ f).card ∈ ({1, 2, 3} : Finset ℕ)) ∧
    (w11.offDiag.filter fun p => (p.1 ∩ p.2).card = 1).card = 990 ∧
    (w11.offDiag.filter fun p => (p.1 ∩ p.2).card = 2).card = 1320 ∧
    (w11.offDiag.filter fun p => (p.1 ∩ p.2).card = 3).card = 1980 := by
  native_decide

/-! ### The stabiliser of `0, 1, 2, 3` is trivial -/

/-- The points other than `0, 1, 2, 3`. -/
abbrev Rest : Type := {x : Fin 11 // 4 ≤ x.val}

/-- The 5040 permutations of the other seven points: only the identity preserves `w11`. -/
theorem stab_check :
    ∀ τ : Equiv.Perm Rest, (∀ e ∈ w11, pmap (Equiv.Perm.ofSubtype τ) e ∈ w11) → τ = 1 := by
  native_decide

/-- The base tuple `(0, 1, 2, 3)`. -/
def base : Fin 4 ↪ Fin 11 := Fin.castLEEmb (by norm_num)

@[simp] theorem base_apply (i : Fin 4) : (base i).val = i.val := rfl

/-- An automorphism fixing `0, 1, 2, 3` is the identity. -/
theorem eq_one_of_fixes_base {σ : Equiv.Perm (Fin 11)} (hσ : σ ∈ aut w11)
    (hfix : ∀ i, σ (base i) = base i) : σ = 1 := by
  have small : ∀ x : Fin 11, x.val < 4 → σ x = x := by
    intro x hx
    have := hfix ⟨x.val, hx⟩
    rwa [show base ⟨x.val, hx⟩ = x from Fin.ext rfl] at this
  have h₁ : ∀ x, 4 ≤ (σ x).val ↔ 4 ≤ x.val := by
    intro x
    constructor
    · intro h
      by_contra hx
      rw [small x (by omega)] at h
      omega
    · intro hx
      by_contra h
      have := small (σ x) (by omega)
      have := σ.injective this
      subst this
      omega
  have h₂ : ∀ x, σ x ≠ x → 4 ≤ x.val := fun x hx => by
    by_contra h
    exact hx (small x (by omega))
  have hsub : σ.subtypePerm h₁ = 1 := by
    apply stab_check
    rw [Equiv.Perm.ofSubtype_subtypePerm h₁ h₂]
    exact mem_aut_iff_forall.1 hσ
  rw [← Equiv.Perm.ofSubtype_subtypePerm h₁ h₂, hsub, map_one]

/-! ### An automorphism for every ordered 4-tuple -/

/-- The first element of `U` sending `k` to `y`, or `1`. -/
def pick (U : List (Equiv.Perm (Fin 11))) (k y : Fin 11) : Equiv.Perm (Fin 11) :=
  (U.find? fun u => u k = y).getD 1

/-- The automorphism `u₀ u₁ u₂ u₃` sending `(0, 1, 2, 3)` to `(t 0, t 1, t 2, t 3)`. -/
def wit (t : Fin 4 → Fin 11) : Equiv.Perm (Fin 11) :=
  let a := pick wittU0 0 (t 0)
  let b := pick wittU1 1 (a.symm (t 1))
  let c := pick wittU2 2 ((a * b).symm (t 2))
  let d := pick wittU3 3 ((a * b * c).symm (t 3))
  a * b * c * d

/-- For each of the 7920 ordered 4-tuples `t` of distinct points, `wit t` preserves `w11` and
sends the base to `t`. -/
theorem wit_check :
    ∀ t : Fin 4 → Fin 11, Function.Injective t →
      (∀ e ∈ w11, pmap (wit t) e ∈ w11) ∧ ∀ i, wit t (base i) = t i := by
  native_decide

theorem wit_mem (t : Fin 4 ↪ Fin 11) : wit t ∈ aut w11 :=
  mem_aut_iff_forall.2 (wit_check t t.injective).1

theorem wit_base (t : Fin 4 ↪ Fin 11) (i : Fin 4) : wit t (base i) = t i :=
  (wit_check t t.injective).2 i

/-! ### Theorem A2 -/

theorem smul_emb_apply (σ : aut w11) (t : Fin 4 ↪ Fin 11) (i : Fin 4) :
    (σ • t) i = (σ : Equiv.Perm (Fin 11)) (t i) := rfl

/-- The image of the base tuple. -/
def tuple (σ : aut w11) : Fin 4 ↪ Fin 11 := σ • base

theorem tuple_injective : Function.Injective tuple := by
  intro σ ρ h
  have hfix : ∀ i, ((ρ : Equiv.Perm (Fin 11))⁻¹ * σ) (base i) = base i := by
    intro i
    have := congrArg (fun t : Fin 4 ↪ Fin 11 => t i) h
    simp only [tuple, smul_emb_apply] at this
    rw [Equiv.Perm.mul_apply, this, Equiv.Perm.inv_def, Equiv.symm_apply_apply]
  have := eq_one_of_fixes_base ((aut w11).mul_mem ((aut w11).inv_mem ρ.2) σ.2) hfix
  exact Subtype.ext (inv_mul_eq_one.1 this).symm

theorem tuple_surjective : Function.Surjective tuple := fun t =>
  ⟨⟨wit t, wit_mem t⟩, by
    ext i
    show wit t (base i) = t i
    exact wit_base t i⟩

/-- **Theorem A2.** `|Aut(w11)| = 7920 = 11·10·9·8`. -/
theorem card_aut_w11 : Nat.card (aut w11) = 7920 := by
  rw [Nat.card_eq_of_bijective tuple ⟨tuple_injective, tuple_surjective⟩,
    Nat.card_eq_fintype_card, Fintype.card_embedding_eq]
  simp

/-- **Theorem A2.** `Aut(w11)` is 4-transitive on the points. -/
instance w11_four_transitive : MulAction.IsMultiplyPretransitive (aut w11) (Fin 11) 4 where
  exists_smul_eq s t :=
    ⟨⟨wit t * (wit s)⁻¹, (aut w11).mul_mem (wit_mem t) ((aut w11).inv_mem (wit_mem s))⟩, by
      ext i
      show (wit t * (wit s)⁻¹) (s i) = t i
      rw [Equiv.Perm.mul_apply, ← wit_base s i, Equiv.Perm.inv_def, Equiv.symm_apply_apply,
        wit_base]⟩

/-- **Theorem A2.** The action on ordered 4-tuples is free: with `w11_four_transitive`,
`Aut(w11)` is sharply 4-transitive. -/
theorem w11_four_free (σ : aut w11) (t : Fin 4 ↪ Fin 11) (h : σ • t = t) : σ = 1 := by
  have hfix : ∀ i, ((wit t)⁻¹ * σ * wit t) (base i) = base i := by
    intro i
    have := congrArg (fun u : Fin 4 ↪ Fin 11 => u i) h
    simp only [smul_emb_apply] at this
    rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, wit_base, this, ← wit_base t i,
      Equiv.Perm.inv_def, Equiv.symm_apply_apply]
  have h1 := eq_one_of_fixes_base
    ((aut w11).mul_mem ((aut w11).mul_mem ((aut w11).inv_mem (wit_mem t)) σ.2) (wit_mem t)) hfix
  have : (σ : Equiv.Perm (Fin 11)) = 1 :=
    calc (σ : Equiv.Perm (Fin 11)) = wit t * ((wit t)⁻¹ * σ * wit t) * (wit t)⁻¹ := by group
      _ = 1 := by rw [h1]; group
  exact Subtype.ext this

/-- `Aut(w11)` is primitive: a 2-transitive action is (Mathlib). -/
theorem w11_preprimitive : MulAction.IsPreprimitive (aut w11) (Fin 11) :=
  MulAction.isPreprimitive_of_is_two_pretransitive
    (MulAction.isMultiplyPretransitive_of_le (n := 4) (by norm_num) (by simp))

end HD.Witt
