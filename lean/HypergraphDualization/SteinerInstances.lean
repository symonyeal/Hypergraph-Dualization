# Intersecting Steiner systems that are 2-colourable (research track A, item A5)

`PG(2,4)` and `S(4,7,23)` have `n₀ = 0`: no two blocks are disjoint. They are still not
self-transversal, because each has a 2-colouring, i.e. a blocking set containing no block. The
data are generated by `experiments/steiner_selftr.py --lean` (`SteinerData`). The finite checks
are `native_decide` evaluations of `List.all`, which `native_decide` runs quickly; a bounded
quantifier over a `Finset` literal is much slower.

| Lean | Statement |
| --- | --- |
| `isSteiner_of_packing` | `k`-uniform, distinct blocks share `< t` points, `b·C(k,t) = C(v,t)`: a Steiner system |
| `pg24_steiner`, `pg24_intersecting`, `pg24_tr_ne` | `PG(2,4)` is `S(2,5,21)`, intersecting, not self-transversal |
| `s4723_steiner`, `s4723_intersecting`, `s4723_tr_ne` | the Golay design is `S(4,7,23)`, intersecting, not self-transversal |
-/
import HypergraphDualization.Steiner
import HypergraphDualization.SteinerData
import HypergraphDualization.Instances

namespace HD

open Finset

variable {α : Type*} [DecidableEq α]

/-- A `k`-uniform family on `U` in which distinct blocks share fewer than `t` points, with
`b · C(k, t) = C(v, t)`, is a Steiner system `S(t, k, v)`: the `t`-subsets of distinct blocks
are distinct, and there are as many as `t`-subsets of `U`. -/
theorem isSteiner_of_packing {U : Finset α} {H : Finset (Finset α)} {t k : ℕ} (hW : Within U H)
    (hk : ∀ e ∈ H, e.card = k) (hp : ∀ e ∈ H, ∀ f ∈ H, e ≠ f → (e ∩ f).card < t)
    (hb : H.card * k.choose t = U.card.choose t) : IsSteiner U H t k := by
  have key : ∀ T : Finset α, T.card = t → ∀ e ∈ H, ∀ f ∈ H, T ⊆ e → T ⊆ f → e = f := by
    intro T hT e he f hf hTe hTf
    by_contra hef
    have := card_le_card (subset_inter hTe hTf)
    have := hp e he f hf hef
    omega
  have hd : (H : Set (Finset α)).PairwiseDisjoint fun e => e.powersetCard t := by
    intro e he f hf hef
    refine disjoint_left.2 fun T hTe hTf => hef ?_
    rw [mem_coe] at he hf
    rw [mem_powersetCard] at hTe hTf
    exact key T hTe.2 e he f hf hTe.1 hTf.1
  set P := H.biUnion fun e => e.powersetCard t
  have hP : P.card = U.card.choose t := by
    rw [card_biUnion hd, sum_congr rfl fun e he => by rw [card_powersetCard, hk e he], sum_const,
      smul_eq_mul, hb]
  have hsub : P ⊆ U.powersetCard t := fun T hT => by
    obtain ⟨e, he, hT⟩ := mem_biUnion.1 hT
    rw [mem_powersetCard] at hT ⊢
    exact ⟨hT.1.trans (hW e he), hT.2⟩
  have heq : P = U.powersetCard t :=
    eq_of_subset_of_card_le hsub (by rw [card_powersetCard, hP])
  refine ⟨hW, hk, fun T hTU hT => ?_⟩
  have : T ∈ P := heq ▸ mem_powersetCard.2 ⟨hTU, hT⟩
  obtain ⟨e, he, hTe⟩ := mem_biUnion.1 this
  rw [mem_powersetCard] at hTe
  rw [card_eq_one]
  refine ⟨e, eq_singleton_iff_unique_mem.2 ⟨mem_filter.2 ⟨he, hTe.1⟩, fun f hf => ?_⟩⟩
  rw [mem_filter] at hf
  exact key T hT f hf.1 e he hf.2 hTe.1

/-- The finite checks behind a Steiner system given as a list of blocks: no repetition, `b`
blocks of size `k`, distinct blocks sharing fewer than `t` points. -/
def packingCheck (L : List (Finset α)) (b k t : ℕ) : Bool :=
  decide L.Nodup && L.length == b && (L.all fun e => e.card == k) &&
    L.all fun e => L.all fun f => e == f || decide ((e ∩ f).card < t)

theorem isSteiner_of_check {n b k t : ℕ} (L : List (Finset (Fin n)))
    (h : packingCheck L b k t = true) (hb : b * k.choose t = n.choose t) :
    IsSteiner univ L.toFinset t k := by
  simp only [packingCheck, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, List.all_eq_true,
    Bool.or_eq_true] at h
  obtain ⟨⟨⟨hnd, hlen⟩, hk⟩, hp⟩ := h
  refine isSteiner_of_packing (fun _ _ => subset_univ _) (fun e he => hk e (List.mem_toFinset.1 he))
    (fun e he f hf hef => ?_) ?_
  · rcases hp e (List.mem_toFinset.1 he) f (List.mem_toFinset.1 hf) with h | h
    · exact absurd h hef
    · exact h
  · rw [List.toFinset_card_of_nodup hnd, hlen, hb, card_univ, Fintype.card_fin]

/-- An intersecting list of blocks: every two meet. -/
def meetCheck (L : List (Finset α)) : Bool := L.all fun e => L.all fun f => decide (e ∩ f).Nonempty

theorem intersecting_of_check {L : List (Finset α)} (h : meetCheck L = true) :
    OpenAI.Intersecting L.toFinset := by
  simp only [meetCheck, List.all_eq_true, decide_eq_true_eq] at h
  exact fun e he f hf _ => h e (List.mem_toFinset.1 he) f (List.mem_toFinset.1 hf)

/-- `B` meets every block and contains none. -/
def blockingCheck (L : List (Finset α)) (B : Finset α) : Bool :=
  L.all fun e => decide (B ∩ e).Nonempty && !decide (e ⊆ B)

theorem tr_ne_of_check {n : ℕ} {L : List (Finset (Fin n))} {B : Finset (Fin n)}
    (h : blockingCheck L B = true) : tr univ L.toFinset ≠ L.toFinset := by
  simp only [blockingCheck, List.all_eq_true, Bool.and_eq_true, decide_eq_true_eq,
    Bool.not_eq_true', decide_eq_false_iff_not] at h
  refine Data.tr_ne_of_blocking (B := B) (subset_univ _)
    (fun e he => (h e (List.mem_toFinset.1 he)).1) ?_
  rintro ⟨e, he, heB⟩
  exact (h e (List.mem_toFinset.1 he)).2 heB

namespace Steiner

/-- `PG(2,4)`. -/
def pg24 : Finset (Finset (Fin 21)) := pg24L.toFinset

/-- The Steiner system `S(4,7,23)`: weight-7 words of the binary Golay code. -/
def s4723 : Finset (Finset (Fin 23)) := s4723L.toFinset

theorem pg24_steiner : IsSteiner univ pg24 2 5 :=
  isSteiner_of_check (b := 21) _ (by native_decide) (by decide)

theorem s4723_steiner : IsSteiner univ s4723 4 7 :=
  isSteiner_of_check (b := 253) _ (by native_decide) (by decide)

/-- `PG(2,4)` is intersecting (`n₀(2,5,21) = 0`). -/
theorem pg24_intersecting : OpenAI.Intersecting pg24 :=
  intersecting_of_check (by native_decide)

/-- `S(4,7,23)` is intersecting (`n₀(4,7,23) = 0`). -/
theorem s4723_intersecting : OpenAI.Intersecting s4723 :=
  intersecting_of_check (by native_decide)

/-- `PG(2,4)` is not self-transversal: `{0,1,3,4,5,6,8,16}` meets every line and contains none. -/
theorem pg24_tr_ne : tr univ pg24 ≠ pg24 := tr_ne_of_check (B := pg24Colour) (by native_decide)

/-- `S(4,7,23)` is not self-transversal: `{0,1,2,4,5,6,7,8,9,11,12}` meets every block and
contains none. -/
theorem s4723_tr_ne : tr univ s4723 ≠ s4723 := tr_ne_of_check (B := s4723Colour) (by native_decide)

end Steiner

end HD
